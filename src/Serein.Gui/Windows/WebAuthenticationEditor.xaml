<Window
    x:Class="Serein.Gui.Windows.WebAuthenticationEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:Serein.Gui.Controls"
    xmlns:converter="clr-namespace:Serein.Gui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Serein.Gui.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:Serein.Gui.ViewModels"
    Title="网页访问凭证编辑器"
    Width="600"
    Height="400"
    d:DataContext="{d:DesignInstance Type=vm:WebAuthenticationEditorViewModel}"
    ui:ThemeManager.IsThemeAware="True"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.Height="36"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <converter:WebAuthenticationTypeConverter x:Key="WebAuthenticationTypeConverter" />
        <converter:WebAuthenticationValueConverter x:Key="WebAuthenticationValueConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="15,0"
            VerticalAlignment="Center"
            Style="{DynamicResource CaptionTextBlockStyle}"
            Text="网页访问凭证编辑器" />

        <ListView
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="WebAuthenticationListView_MouseDoubleClick"
            SelectionChanged="WebAuthenticationListView_SelectionChanged"
            SelectionMode="Single">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="添加">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                        </MenuItem.Icon>
                        <MenuItem
                            Command="{Binding AddCommand}"
                            CommandParameter="token"
                            Header="令牌" />
                        <MenuItem
                            Command="{Binding AddCommand}"
                            CommandParameter="user"
                            Header="用户" />
                    </MenuItem>
                    <MenuItem
                        Command="{Binding EditCommand}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="编辑"
                        IsEnabled="{Binding CanEdit}">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding RemoveCommand}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="删除"
                        IsEnabled="{Binding CanRemove}">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn
                        Width="70"
                        helpers:GridViewColumnHelper.MinWidth="50"
                        Header="类型">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource WebAuthenticationTypeConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        Width="240"
                        helpers:GridViewColumnHelper.MinWidth="200"
                        DisplayMemberBinding="{Binding Description}"
                        Header="描述" />
                    <GridViewColumn
                        Width="250"
                        helpers:GridViewColumnHelper.MinWidth="200"
                        Header="值">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource WebAuthenticationValueConverter}}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
