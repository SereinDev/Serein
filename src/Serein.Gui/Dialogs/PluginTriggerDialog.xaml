<ui:ContentDialog
    x:Class="Serein.Gui.Dialogs.PluginTriggerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Serein.Gui.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    MinWidth="300"
    d:DataContext="{d:DesignInstance Type=local:PluginTriggerDialog}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="确定"
    mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DialogContentStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ContentDialog.Resources>

    <StackPanel>
        <CheckBox Content="启用触发器" IsChecked="{Binding IsEnabled, Mode=TwoWay}"  Margin="0,0,0,10"/>

        <TextBox
            ui:ControlHelper.Header="插件标识符"
            Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</ui:ContentDialog>
