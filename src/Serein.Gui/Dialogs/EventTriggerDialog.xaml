<ui:ContentDialog
    x:Class="Serein.Gui.Dialogs.EventTriggerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Serein.Gui.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Serein.Core.Models.Automations;assembly=Serein.Core"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    MinWidth="300"
    d:DataContext="{d:DesignInstance Type=local:EventTriggerDialog}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="确定"
    mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DialogContentStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ContentDialog.Resources>

    <StackPanel>
        <CheckBox Content="启用触发器" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,0,10"/>

        <ComboBox
            ui:ControlHelper.Header="事件"
            SelectedValue="{Binding Event, Mode=TwoWay}"
            SelectedValuePath="Tag">
            <ComboBoxItem Tag="{x:Static models:Events.None}">无</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.ServerStart}">服务器启动</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.ServerExitedNormally}">服务器关闭：正常退出</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.ServerExitedUnexpectedly}">服务器关闭：不正常退出</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.GroupIncreased}">群人数增加</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.GroupDecreased}">群人数减少</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.GroupPoke}">群戳一戳</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.BindingSucceeded}">绑定成功</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.UnbindingSucceeded}">解绑成功</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.PermissionDeniedFromPrivateMsg}">权限不足：私聊</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.PermissionDeniedFromGroupMsg}">权限不足：群聊</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:Events.SereinCrash}">Serein崩溃</ComboBoxItem>
        </ComboBox>
    </StackPanel>
</ui:ContentDialog>
