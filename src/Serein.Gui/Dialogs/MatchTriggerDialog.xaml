<ui:ContentDialog
    x:Class="Serein.Gui.Dialogs.MatchTriggerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Serein.Gui.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Serein.Core.Models.Automations;assembly=Serein.Core"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    MinWidth="360"
    d:DataContext="{d:DesignInstance Type=local:MatchTriggerDialog}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="确定"
    mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DialogContentStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ContentDialog.Resources>

    <StackPanel>
        <CheckBox Content="启用触发器" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,0,10" />

        <ComboBox
            ui:ControlHelper.Header="匹配域"
            SelectedValue="{Binding FieldType, Mode=TwoWay}"
            SelectedValuePath="Tag">
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.ServerOutput}">服务器输出</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.ServerInput}">服务器输入</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.GroupMsg}">群聊消息</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.PrivateMsg}">私聊消息</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.SelfMsg}">自身消息</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.ChannelMsg}">频道消息</ComboBoxItem>
            <ComboBoxItem Tag="{x:Static models:MatchFieldType.GuildMsg}">群组消息</ComboBoxItem>
        </ComboBox>

        <CheckBox
            Content="使用正则表达式"
            IsChecked="{Binding IsRegex, Mode=TwoWay}"
            />

        <CheckBox
            Content="需要管理员权限"
            IsChecked="{Binding RequireAdminPermission, Mode=TwoWay}">
            <CheckBox.Style>
                <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static models:MatchFieldType.ServerOutput}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FieldType}" Value="{x:Static models:MatchFieldType.ServerInput}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </CheckBox.Style>
        </CheckBox>

        <TextBox
            Height="100"
            ui:ControlHelper.Header="匹配内容"
            AcceptsReturn="True"
            Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />

        <ui:InfoBar
            x:Name="RegexErrorInfoBar"
            Margin="0,10,0,0"
            IsClosable="False"
            Severity="Error"
            Title="正则表达式无效">
            <ui:InfoBar.Style>
                <Style TargetType="ui:InfoBar">
                    <Setter Property="IsOpen" Value="False" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRegex}" Value="True" />
                                <Condition Binding="{Binding Regex}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsOpen" Value="True" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:InfoBar.Style>
        </ui:InfoBar>
    </StackPanel>
</ui:ContentDialog>
