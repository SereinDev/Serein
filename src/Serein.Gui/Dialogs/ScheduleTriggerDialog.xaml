<ui:ContentDialog
    x:Class="Serein.Gui.Dialogs.ScheduleTriggerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Serein.Gui.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:validations="clr-namespace:Serein.Gui.Validations"
    MinWidth="380"
    d:DataContext="{d:DesignInstance Type=local:ScheduleTriggerDialog}"
    d:DesignHeight="500"
    d:DesignWidth="800"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="确定"
    mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DialogContentStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ContentDialog.Resources>

    <StackPanel>
        <CheckBox Content="启用触发器" IsChecked="{Binding IsEnabled, Mode=TwoWay}"  Margin="0,0,0,10"/>

        <TextBox
            x:Name="CronExpressionTextBox"
            ui:ControlHelper.Header="Cron表达式"
            TextChanged="CronExpressionTextBox_TextChanged">
            <TextBox.Text>
                <Binding Mode="TwoWay" Path="CronExpression" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validations:CronExpressionValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <ui:InfoBar
            x:Name="ErrorInfoBar"
            Margin="0,10,0,0"
            IsClosable="False"
            IsOpen="False"
            Severity="Error"
            Title="Cron表达式无效" />

        <TextBlock Margin="0,10,0,6" Text="最近十次执行时间" />
        <ListBox x:Name="OccurrencesListBox" Height="180" />
    </StackPanel>
</ui:ContentDialog>
