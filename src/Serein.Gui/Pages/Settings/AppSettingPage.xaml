<ui:Page
    x:Class="Serein.Gui.Pages.Settings.AppSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Serein.Core.Services.Data;assembly=Serein.Core"
    xmlns:local="clr-namespace:Serein.Gui.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:net="clr-namespace:Serein.Core.Services.Network;assembly=Serein.Core"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:Serein.Gui.ViewModels"
    Title="应用设置"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppSettingPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettingPageBaseStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ui:ScrollViewerEx>
        <StackPanel Margin="20,5,20,20">
            <TextBlock
                Margin="0,15,0,5"
                Style="{DynamicResource SubtitleTextBlockStyle}"
                Text="插件" />

            <ui:SettingsCard Description="超出此时间返回的结果将被忽略；设置成0可禁用等待" Header="事件最大等待时间 (ms)">
                <ui:NumberBox
                    Width="150"
                    MinWidth="100"
                    Margin="0,5,0,10"
                    HorizontalAlignment="Left"
                    LostFocus="OnPropertyChanged"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"                    Value="{Binding ApplicationSetting.MaximumWaitTimeForPluginEvents}" />
            </ui:SettingsCard>

            <ui:SettingsExpander Description="此处的程序集将会被所有Js插件加载" Header="Js插件默认加载的程序集">
                <ui:SettingsExpander.ItemsHeader>
                    <ui:InfoBar
                        Title="提示"
                        BorderThickness="0"
                        CornerRadius="0"
                        IsOpen="True"
                        Severity="Informational">
                        <ui:InfoBar.Message>
                            使用换行符分隔每一个值，即一行一个值
                        </ui:InfoBar.Message>
                    </ui:InfoBar>
                </ui:SettingsExpander.ItemsHeader>

                <ui:SettingsExpander.Items>
                    <ui:SettingsCard ContentAlignment="Left">
                        <TextBox
                            AcceptsReturn="True"
                            LostFocus="OnPropertyChanged"
                            Text="{Binding ApplicationSetting.JsDefaultAssemblies, Converter={StaticResource multiLinesConverter}}"
                            TextWrapping="Wrap" />
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <ui:SettingsExpander Description="凡是以所选内容结尾的文件都不会被加载" Header="Js插件加载时忽略的文件后缀">
                <ui:SettingsExpander.ItemsHeader>
                    <ui:InfoBar
                        Title="提示"
                        BorderThickness="0"
                        CornerRadius="0"
                        IsOpen="True"
                        Severity="Informational">
                        <ui:InfoBar.Message>
                            使用换行符分隔每一个值，即一行一个值
                        </ui:InfoBar.Message>
                    </ui:InfoBar>
                </ui:SettingsExpander.ItemsHeader>

                <ui:SettingsExpander.Items>
                    <ui:SettingsCard ContentAlignment="Left">
                        <TextBox
                            AcceptsReturn="True"
                            LostFocus="OnPropertyChanged"
                            Text="{Binding ApplicationSetting.JsFilesToExcludeFromLoading, Converter={StaticResource multiLinesConverter}}"
                            TextWrapping="Wrap" />
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>


            <ui:SettingsExpander Header="允许Js插件使用Web API">
                <ui:SettingsExpander.Description>
                    <sys:String xml:space="preserve">在Js引擎中注册Web API，如fetch()、TextDecoder、ReadableStream等，开发者可以直接使用这些API而无需额外引入库
· 此功能仍处于实验性阶段，可能存在一些问题（见下）</sys:String>
                </ui:SettingsExpander.Description>

                <ui:SettingsExpander.ItemsHeader>
                    <ui:InfoBar
                        Title="警告"
                        BorderThickness="0"
                        CornerRadius="0"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Warning">
                        <ui:InfoBar.Message>
                            <sys:String xml:space="preserve">· 由于异步相关的操作均由C#的Task类实现而非WHATWG标准中的“微任务/Micro Task”，因此可能与浏览器或NodeJs环境下的行为存在一定差异，而且在高并发环境下可能存在引擎死锁或其他不确定的问题
· 目前开发进度受限，部分API还未实现（如fetch()、ReadableStreamBYOBReader），具体进度可参考仓库的REAMDE文件</sys:String>
                        </ui:InfoBar.Message>
                    </ui:InfoBar>
                </ui:SettingsExpander.ItemsHeader>

                <ui:SettingsExpander.Items>
                    <ui:SettingsCard Description="猜你想问 / 了解更多" Header="什么是Web API？Web API包含哪些内容？">
                        <ui:HyperlinkButton Content="MDN 文档" NavigateUri="https://developer.mozilla.org/zh-CN/docs/Web/API" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Description="实现这个功能的库" Header="GitHub仓库">
                        <ui:HyperlinkButton Content="Zaitonn/Yilduz" NavigateUri="https://github.com/Zaitonn/Yilduz" />
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>

                <ui:ToggleSwitch IsOn="{Binding ApplicationSetting.EnableWebAPIForJsPlugins}" Toggled="OnPropertyChanged" />

            </ui:SettingsExpander>

            <TextBlock
                Margin="0,15,0,5"
                Style="{DynamicResource SubtitleTextBlockStyle}"
                Text="绑定" />

            <ui:SettingsExpander Description="绑定时游戏名称需要符合此正则" Header="游戏名称检验正则">
                <ui:SettingsExpander.ItemsHeader>
                    <ui:InfoBar
                        Title="提示"
                        BorderThickness="0"
                        CornerRadius="0"
                        IsOpen="True"
                        Severity="Informational">
                        <ui:InfoBar.Message>
                            正则语法错误可能导致无法正确处理绑定
                        </ui:InfoBar.Message>
                    </ui:InfoBar>
                </ui:SettingsExpander.ItemsHeader>

                <TextBlock Style="{DynamicResource SettingsExpanderValue}" Text="{Binding ApplicationSetting.GameIdValidationPattern}" />

                <ui:SettingsExpander.Items>
                    <ui:SettingsCard ContentAlignment="Left">
                        <TextBox
                            AcceptsReturn="False"
                            LostFocus="OnPropertyChanged"
                            Text="{Binding ApplicationSetting.GameIdValidationPattern}"
                            TextWrapping="Wrap" />
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <ui:SettingsCard Description="只影响通过Serein命令执行的绑定" Header="当服务器关闭时禁用绑定功能">
                <ui:ToggleSwitch IsOn="{Binding ApplicationSetting.DisableBindingManagerWhenAllServersStopped}" Toggled="OnPropertyChanged" />
            </ui:SettingsCard>

            <TextBlock
                Margin="0,15,0,5"
                Style="{DynamicResource SubtitleTextBlockStyle}"
                Text="其他" />

            <ui:SettingsExpander Description="当输入的内容若含有以下内容将触发多行匹配" Header="用于触发多行匹配的文本">
                <ui:SettingsExpander.ItemsHeader>
                    <ui:InfoBar
                        Title="提示"
                        BorderThickness="0"
                        CornerRadius="0"
                        IsOpen="True"
                        Severity="Informational">
                        <ui:InfoBar.Message>
                            使用换行符分隔每一个值，即一行一个值
                        </ui:InfoBar.Message>
                    </ui:InfoBar>
                </ui:SettingsExpander.ItemsHeader>

                <ui:SettingsExpander.Items>
                    <ui:SettingsCard ContentAlignment="Left">
                        <TextBox
                            AcceptsReturn="True"
                            LostFocus="OnPropertyChanged"
                            Text="{Binding ApplicationSetting.MultiLineMatchingPatterns, Converter={StaticResource multiLinesConverter}}"
                            TextWrapping="Wrap" />
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <ui:SettingsCard Header="启用Sentry上报">
                <ui:SettingsCard.Description>
                    <sys:String xml:space="preserve">当出现异常或崩溃时自动匿名上报，便于开发者及时定位问题（建议开启）
· 更改后重启生效
· 上报时可能会收集部分系统和环境信息并产生一定网络流量</sys:String>
                </ui:SettingsCard.Description>
                <ui:ToggleSwitch IsOn="{Binding ApplicationSetting.EnableSentry}" Toggled="OnPropertyChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Command="{Binding OpenConsoleCommand}"
                Description="查看Serein内部的输出，这可能带来一定卡顿和延迟"
                Header="打开日志控制台"
                IsClickEnabled="True" />

            <TextBlock
                Margin="0,15,0,5"
                Style="{DynamicResource SubtitleTextBlockStyle}"
                Text="外观" />

            <ui:SettingsCard Header="主题颜色">
                <ui:SettingsCard.Description>
                    <sys:String xml:space="preserve">决定Serein的主题样式
· 跟随系统选项可能无法生效</sys:String>
                </ui:SettingsCard.Description>

                <ComboBox SelectedIndex="{Binding ApplicationSetting.Theme, Converter={StaticResource enumValueConverter}}" SelectionChanged="OnPropertyChanged">
                    <ComboBoxItem>跟随系统</ComboBoxItem>
                    <ComboBoxItem>浅色</ComboBoxItem>
                    <ComboBoxItem>深色</ComboBoxItem>
                </ComboBox>
            </ui:SettingsCard>

            <ui:SettingsExpander Header="标题后缀">
                <TextBlock Style="{DynamicResource SettingsExpanderValue}" Text="{Binding ApplicationSetting.CustomTitle}" />

                <ui:SettingsExpander.Description>
                    <sys:String xml:space="preserve">显示在标题栏的内容
· 可使用命令的变量</sys:String>
                </ui:SettingsExpander.Description>
                <ui:SettingsExpander.Items>
                    <ui:SettingsCard ContentAlignment="Left">
                        <TextBox
                            LostFocus="OnPropertyChanged"
                            Text="{Binding ApplicationSetting.CustomTitle, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </ui:SettingsCard>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <TextBlock
                Margin="0,15,0,5"
                Style="{DynamicResource SubtitleTextBlockStyle}"
                Text="更新" />

            <ui:SettingsCard Description="启动后自动获取更新提示（建议开启）" Header="获取更新提示">
                <ui:ToggleSwitch IsOn="{Binding ApplicationSetting.CheckUpdate}" Toggled="OnPropertyChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard Description="应用关闭后自动替换新版本" Header="自动更新">
                <ui:ToggleSwitch
                    IsEnabled="{Binding ApplicationSetting.CheckUpdate}"
                    IsOn="{Binding ApplicationSetting.AutoUpdate}"
                    Toggled="OnPropertyChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Command="{Binding CheckUpdateCommand}"
                Header="检查更新"
                IsClickEnabled="True" />

            <ui:InfoBar
                x:Name="VersionInfoBar"
                Title="{Binding VersionInfoTitle}"
                Margin="0,5"
                IsClosable="False"
                IsOpen="{Binding IsVersionInfoOpen}"
                Message="{Binding VersionInfoMessage}"
                Severity="{Binding VersionInfoSeverity}" />

            <ui:InfoBar
                x:Name="ReadyToReplaceInfoBar"
                Title="新版本下载完毕"
                Margin="0,5"
                IsClosable="False"
                IsOpen="{Binding UpdateChecker.IsReadyToReplace}"
                Message="重新启动Serein即可更新"
                Severity="Success" />

        </StackPanel>
    </ui:ScrollViewerEx>
</ui:Page>