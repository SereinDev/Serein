<ui:Page
    x:Class="Serein.Gui.Pages.PluginListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:Serein.Gui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Serein.Gui.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewModels="clr-namespace:Serein.Gui.ViewModels"
    Title="插件"
    d:DataContext="{d:DesignInstance Type=viewModels:PluginListPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:StatusConverter x:Key="statusConverter" />
        <converter:AuthorListToStringConverter x:Key="authorListToStringConverter" />
    </Page.Resources>

    <Grid>
        <ListView
            x:Name="PluginListView"
            ItemsSource="{Binding PluginInfos}"
            SelectionChanged="PluginListView_SelectionChanged"
            SelectionMode="Single"
            VirtualizingPanel.IsVirtualizingWhenGrouping="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding DisableCommand}"
                        Header="禁用"
                        IsEnabled="{Binding CanDisable}"
                        Tag="Disable">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.StatusCircleBlock}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding ReloadCommand}"
                        Header="重新加载所有插件"
                        Tag="Reload">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding ClearConsoleCommand}"
                        Header="清空控制台"
                        Tag="ClearConsole">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Command="{Binding OpenDocCommand}"
                        Header="查看文档"
                        Tag="OpenDoc">
                        <MenuItem.Icon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding Value.Info.Name, Mode=OneWay}"
                        Header="名称" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Value.IsEnabled, Mode=OneWay, Converter={StaticResource statusConverter}}"
                        Header="状态" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Value.Info.Version, Mode=OneWay}"
                        Header="版本" />
                    <GridViewColumn
                        Width="100"
                        DisplayMemberBinding="{Binding Value.Info.Authors, Mode=OneWay, Converter={StaticResource authorListToStringConverter}}"
                        Header="作者" />
                    <GridViewColumn
                        Width="230"
                        DisplayMemberBinding="{Binding Value.Info.Description, Mode=OneWay}"
                        Header="描述" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock
            Margin="4"
            VerticalAlignment="Bottom"
            FontSize="13"
            Foreground="Gray"
            Text="{Binding StatusBarText}" />
    </Grid>
</ui:Page>